# Environment variables for AI Resume Analyser
# Copy this to .env and fill in your values. Never commit .env to source control.

# ── Database ──────────────────────────────────────
DB_PASSWORD=your_secure_db_password_here

# ── OpenAI ────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your_openai_api_key_here...
